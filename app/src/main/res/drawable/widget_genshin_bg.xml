<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main Background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#F3EFE0" />
        </shape>
    </item>

    <!-- Outer Gold Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke
                android:width="2dp"
                android:color="#D3BC8E" />
        </shape>
    </item>

    <!-- Subtle Gold Line Decoration -->
    <item android:bottom="164dp" android:left="16dp" android:right="16dp" android:top="28dp">
        <shape android:shape="rectangle">
            <solid android:color="#22D3BC8E" />
        </shape>
    </item>
</layer-list>
